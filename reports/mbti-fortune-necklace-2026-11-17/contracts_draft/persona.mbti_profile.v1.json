{
  "id": "persona.mbti_profile.v1",
  "role": "A 16-type personality code (four letters) and an age -> a sample birth date that makes that age today, drawn reproducibly, and the code's four axes (our own mapping for fun; not affiliated with The Myers-Briggs Company)",
  "sample_rule": "Range: the dates D with today - (age+1) years < D <= today - age years (a 29 February anchor in a non-leap year is 28 February). Seed: sha256('mbti-fortune|v1|' + TYPE + '|' + age + '|' + today) as a hex integer, TYPE the four upper-case letters without -A/-T, today YYYY-MM-DD in Asia/Seoul. The sample is the range's dates in ascending order at index seed mod the range's length. A range outside 1912-2100 is refused (invalid_input), never redrawn.",
  "input_schema": {
    "type": "object",
    "properties": {
      "mbti": {
        "type": "string",
        "pattern": "^[EIei][SNsn][TFtf][JPjp](-[ATat])?$",
        "maxLength": 6
      },
      "age": {
        "type": "integer",
        "minimum": 0,
        "maximum": 110
      },
      "today": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "required": [
      "mbti",
      "age"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 2000
      },
      "source": {
        "type": "string",
        "maxLength": 500
      },
      "type": {
        "type": "string",
        "pattern": "^[EI][SN][TF][JP]$"
      },
      "axes": {
        "type": "object",
        "properties": {
          "energy": {
            "type": "string",
            "enum": [
              "E",
              "I"
            ]
          },
          "information": {
            "type": "string",
            "enum": [
              "S",
              "N"
            ]
          },
          "decisions": {
            "type": "string",
            "enum": [
              "T",
              "F"
            ]
          },
          "structure": {
            "type": "string",
            "enum": [
              "J",
              "P"
            ]
          }
        },
        "required": [
          "energy",
          "information",
          "decisions",
          "structure"
        ],
        "additionalProperties": false
      },
      "temperament": {
        "type": "string",
        "enum": [
          "NT",
          "NF",
          "SJ",
          "SP"
        ]
      },
      "age": {
        "type": "integer"
      },
      "today": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "sample_birth_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "sample_range": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "sample_notice": {
        "type": "string",
        "const": "The birth date is a sample drawn from your age, not your real birthday."
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  }
}
