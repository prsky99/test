# cp gateway.env.example gateway.env 후 값 채우기. gateway.env는 커밋 금지.
DOMAIN=myagentgw.duckdns.org
GATEWAY_FREE=1                    # 무료 정책: 모든 소개·재소개 무료 (0 이면 재소개 유료)
NETWORK=base-sepolia              # 유료 정책일 때 수수료를 받을 네트워크 (실제 수수료는 base)
GATEWAY_WALLET=                   # 유료 정책일 때만 필요: 본인 PC에서 만든 지갑의 "주소"만 (무료 정책이면 비워 둠)
ADMIN_TOKEN=                      # openssl rand -hex 24
CRAWL_MIN_GAP_SECONDS=60          # 연속 수집: 한 바퀴 끝나고 다음 바퀴까지 쉬는 시간
CRAWL_PAGE_DELAY=1.0              # 수집 페이지 사이 간격(초). 요청 속도를 고정해 에이전트가 늘어도 순간 부하 일정
CRAWL_FULL_INTERVAL_HOURS=24      # MCP 전체 수집(삭제 확인) 주기. 그 사이에는 바뀐 것만 수집
CAPABILITY_MAX_AGE_HOURS=24       # MCP 도구 목록(지원 언어·나라·통화) 조사 주기
CAPABILITY_WORKERS=8              # 도구 목록 동시 조사 수
AUTH_DISCOVERY_MAX_AGE_DAYS=7     # 인증 필요 MCP의 인증 방법(OAuth 메타데이터·API 키 발급처) 조사 주기
USAGE_TRIALS=1                    # 활성 MCP의 안전한(읽기 전용) 도구를 실제로 호출해 사용 예제 검증 (0이면 끔)
USAGE_TRIAL_MAX_AGE_DAYS=7        # 도구 목록이 그대로면 이 주기로만 다시 호출 (바뀌면 바로 다시)
AGENT_DISCOVERY=1                 # AI 에이전트(A2A) 수집: ERC-8004 온체인 등록부 + 아는 호스트의 well-known agent card (0이면 끔)
ERC8004_CHAINS=base,ethereum,bsc  # ERC-8004를 읽을 체인 (키 없는 공개 RPC, 빈 값이면 끔)
HEALTH_INTERVAL_MINUTES=60        # 헬스체크 주기 (소개 중인 에이전트는 15분)
HEALTH_WORKERS=32                 # 동시 점검 수 (같은 호스트는 1초 간격으로 하나씩)
RESCAN_INTERVAL_MINUTES=15
MIN_CONFIRMATIONS=2
DUCKDNS_SUBDOMAIN=myagentgw       # DuckDNS 서브도메인 (.duckdns.org 제외)
DUCKDNS_TOKEN=                    # duckdns.org 로그인 후 보이는 토큰
