# cp gateway.env.example gateway.env 후 값 채우기. gateway.env는 커밋 금지.
DOMAIN=agentconcierge.biz
GATEWAY_FREE=1                    # 무료 정책: 모든 소개·재소개 무료 (0 이면 재소개 유료)
NETWORK=base-sepolia              # 유료 정책일 때 수수료를 받을 네트워크 (실제 수수료는 base)
GATEWAY_WALLET=                   # 유료 정책일 때만 필요: 본인 PC에서 만든 지갑의 "주소"만 (무료 정책이면 비워 둠)
ADMIN_TOKEN=                      # openssl rand -hex 24
CRAWL_MIN_GAP_SECONDS=60          # 연속 수집: 한 바퀴 끝나고 다음 바퀴까지 쉬는 시간
CRAWL_PAGE_DELAY=1.0              # 수집 페이지 사이 간격(초). 요청 속도를 고정해 에이전트가 늘어도 순간 부하 일정
CRAWL_FULL_INTERVAL_HOURS=24      # MCP 전체 수집(삭제 확인) 주기. 그 사이에는 바뀐 것만 수집
CAPABILITY_MAX_AGE_HOURS=24       # MCP 도구 목록(지원 언어·나라·통화) 조사 주기
CAPABILITY_WORKERS=8              # 도구 목록 동시 조사 수
AUTH_DISCOVERY_MAX_AGE_DAYS=7     # 인증 필요 MCP의 인증 방법(OAuth 메타데이터·API 키 발급처) 조사 주기
USAGE_TRIALS=1                    # 활성 MCP의 안전한(읽기 전용) 도구를 실제로 호출해 사용 예제 검증 (0이면 끔)
USAGE_TRIAL_MAX_AGE_DAYS=7        # 도구 목록이 그대로면 이 주기로만 다시 호출 (바뀌면 바로 다시)
AGENT_DISCOVERY=1                 # AI 에이전트(A2A) 수집: ERC-8004 온체인 등록부 + 아는 호스트의 well-known agent card (0이면 끔)
ERC8004_CHAINS=base,ethereum,bsc  # ERC-8004를 읽을 체인 (키 없는 공개 RPC, 빈 값이면 끔)
HEALTH_INTERVAL_MINUTES=360       # 헬스체크 주기 (기본 6시간, 소개 중인 에이전트는 15분)
HEALTH_WORKERS=32                 # 동시 점검 수 (같은 호스트는 1초 간격으로 하나씩)
RESCAN_INTERVAL_MINUTES=15
MIN_CONFIRMATIONS=2
DUCKDNS_SUBDOMAIN=myagentgw       # DuckDNS 서브도메인 (.duckdns.org 제외)
DUCKDNS_TOKEN=                    # duckdns.org 로그인 후 보이는 토큰
AGENT_FRONT=1                     # 에이전트 전용 프론트를 관리 화면과 다른 포트(8400)로 함께 실행
AGENT_FRONT_PORT=8400
SSL_ENABLED=0                     # 8400 포트 자체 SSL 비활성화 (Cloudflare 터널/리버스 프록시 연동 시 0 HTTP 사용. 자체 인증서 필요 시 1)
SSL_CERTFILE=deploy/ssl/cert.pem
SSL_KEYFILE=deploy/ssl/key.pem
AGENT_FRONT_URL=https://agentconcierge.biz  # 에이전트에게 알려 줄 공개 주소 (기본 https://agentconcierge.biz)
CONCIERGE_LLM=off                 # 에이전트 프론트 로컬 LLM: auto(Ollama에 모델이 있으면) | ollama | off (클라우드 VM에는 보통 Ollama가 없음)
OLLAMA_URL=http://127.0.0.1:11434
CONCIERGE_MODEL=gemma4:e4b-mlx
LOG_DIR=logs                         # 로그 저장 기본 폴더
LOG_LEVEL=INFO                       # 로그 레벨: INFO(전체), WARNING, ERROR(에러만)
LOG_COMPRESS_MONTHS=3                # 월별 압축 보관 주기 (기본 3개월 전 로그 압축 후 원본 폴더 삭제)
LOG_ARCHIVE_DIR=logs/archives        # 압축된 월별 아카이브 보관 폴더

# Production security. Keep this file's real copy private (chmod 600).
APPLICATION_STORE_BACKEND=sqlite
# PostgreSQL requires the reviewed native schema and a current writer/restore
# approval. Paths refer to files readable only by the runtime UID (0400/0600).
# The 32-byte key is the existing task-update root key, not its workflow HMAC.
APPLICATION_POSTGRES_DSN_FILE=
APPLICATION_WORKFLOW_KEY_FILE=
# Required for a fresh production database; existing default admin credentials must be changed first.
ADMIN_BOOTSTRAP_PASSWORD=
# Caddy has this fixed address on the isolated Compose network. Override both together if needed.
CADDY_PROXY_IP=172.30.90.2
PROXY_SUBNET=172.30.90.0/24
# Optional upstream hops authenticated by Caddy; space-separated IP/CIDR entries.
# Default trusts local hops only. Do not add CDN ranges without restricting the
# origin and verifying that the upstream overwrites/appends X-Forwarded-For.
CADDY_TRUSTED_UPSTREAMS="127.0.0.1/32 ::1/128"

# Customer sign-in belongs to the public frontend only. Staff login is unchanged.
# Customer routes may be tested by direct URL while the public link stays hidden.
CUSTOMER_WORKSPACE_ACCESS_ENABLED=0
CUSTOMER_WORKSPACE_LINK_ENABLED=0
# Register these exact HTTPS callbacks with each provider. Missing/invalid settings
# disable that provider. Keep client secrets in the private deployment environment.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://agentconcierge.biz/api/customer-auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://agentconcierge.biz/api/customer-auth/github/callback
