# Optional private override at gateway-data/local-model.env (chmod 600).
# Upgraded service releases load this after agentcon.env.
WORKSPACE_MODEL_ENABLED=1
WORKSPACE_MODEL_PROVIDER=openai
WORKSPACE_MODEL_URL=http://192.168.0.25:8000/v1
WORKSPACE_MODEL_NAME=gemma4-e4b-mlx
# Explicit permission for the operator-selected LAN HTTP endpoint.
WORKSPACE_MODEL_ALLOW_HTTP=1
# Disables local Ollama generation, embedding requests and vector publication.
# Existing vectors remain stored; lexical search remains available.
LOCAL_OLLAMA_ENABLED=0
