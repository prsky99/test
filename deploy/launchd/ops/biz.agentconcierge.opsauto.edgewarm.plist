<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 11-12 PM: once a day, fetch the category pages and the weekly report (about 22 requests, capped at 24) so the
     first visitor gets a HIT or UPDATING instead of a MISS (origin max-age 3600, swr 86400). Live pages are warmed
     only after a deploy (post_deploy_check after), never on a timer. -->
<plist version="1.0"><dict>
<key>Label</key><string>biz.agentconcierge.opsauto.edgewarm</string>
<key>ProgramArguments</key><array><string>/Users/kingstonelee/workspace/A2A_Discovery/.venv/bin/python</string><string>-m</string><string>scripts.warm_edge</string><string>--growth-only</string></array>
<key>WorkingDirectory</key><string>/Users/kingstonelee/workspace/A2A_Discovery</string>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>50</integer></dict>
<key>StandardOutPath</key><string>/Users/kingstonelee/workspace/A2A_Discovery/logs/ops/biz.agentconcierge.opsauto.edgewarm.log</string>
<key>StandardErrorPath</key><string>/Users/kingstonelee/workspace/A2A_Discovery/logs/ops/biz.agentconcierge.opsauto.edgewarm.log</string>
<key>Nice</key><integer>10</integer>
</dict></plist>
