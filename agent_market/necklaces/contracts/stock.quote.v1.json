{
  "id": "stock.quote.v1",
  "role": "stock quote (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "symbol": {
        "type": "string",
        "maxLength": 500
      },
      "ticker": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "AAPL named: \\baapl\\b|apple",
    "a price: \\b\\d{2,4}\\.\\d{1,2}\\b",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "symbol": "AAPL",
      "ticker": "AAPL"
    }
  ]
}
