{
  "id": "earthquake.feed.v1",
  "role": "earthquake feed (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "min_magnitude": {
        "type": "integer"
      },
      "minmagnitude": {
        "type": "integer"
      },
      "magnitude": {
        "type": "integer"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "magnitude: \\bmag",
    "M5 or more: \\b[5-9]\\.\\d\\b",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "min_magnitude": 5,
      "minmagnitude": 5,
      "magnitude": 5
    }
  ]
}
