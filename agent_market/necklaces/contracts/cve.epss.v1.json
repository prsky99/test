{
  "id": "cve.epss.v1",
  "role": "Exploit prediction score of a CVE: the FIRST EPSS probability and percentile with its date (PM 11-17, W3; input keys are alternatives)",
  "input_schema": {
    "type": "object",
    "properties": {
      "cve_id": {
        "type": "string",
        "pattern": "^CVE-\\d{4}-\\d{4,}$",
        "maxLength": 30
      },
      "cve": {
        "type": "string",
        "maxLength": 30
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "CVE echoed: CVE-2021-44228",
    "a score: epss|percentile|0\\.\\d+",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "cve_id": "CVE-2021-44228",
      "cve": "CVE-2021-44228"
    }
  ]
}
