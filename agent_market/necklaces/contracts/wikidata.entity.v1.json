{
  "id": "wikidata.entity.v1",
  "role": "Wikidata entity lookup: the item id, label, description and key statements of an entity (PM 11-17, W3; input keys are alternatives)",
  "input_schema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^Q\\d+$",
        "maxLength": 20
      },
      "entity": {
        "type": "string",
        "maxLength": 300
      },
      "query": {
        "type": "string",
        "maxLength": 300
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "entity echoed: Q42|douglas adams",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "id": "Q42",
      "entity": "Douglas Adams",
      "query": "Douglas Adams"
    }
  ]
}
