{
  "id": "sanctions.screen.v1",
  "role": "Sanctions list name screening: whether a name appears on a published sanctions list such as OFAC SDN, with the list and its date (PM 11-17, W3; a name match is information, not a legal determination; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 300
      },
      "entity": {
        "type": "string",
        "maxLength": 300
      },
      "query": {
        "type": "string",
        "maxLength": 300
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "names a sanctions list: \\bSDN\\b|OFAC|sanction",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "name": "Banco Nacional de Cuba",
      "entity": "Banco Nacional de Cuba",
      "query": "Banco Nacional de Cuba"
    }
  ]
}
