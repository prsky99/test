{
  "id": "place.search.v1",
  "role": "place search (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "Paris: paris",
    "address or coordinates: 48\\.85|2\\.29|champ|avenue|address|latitude|\"lat",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "query": "Eiffel Tower"
    }
  ]
}
