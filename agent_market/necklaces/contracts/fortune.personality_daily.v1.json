{
  "id": "fortune.personality_daily.v1",
  "role": "Today's 16-type personality fortune: the Western sign and the saju day master against today's day pillar, blended with the four-letter type by fixed rules (same inputs and date give the same text); for entertainment",
  "input_schema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "pattern": "^[EI][SN][TF][JP]$"
      },
      "sign": {
        "type": "string",
        "maxLength": 20
      },
      "element": {
        "type": "string",
        "maxLength": 10
      },
      "day_master": {
        "type": "string",
        "maxLength": 40
      },
      "today_day_pillar": {
        "type": "string",
        "maxLength": 40
      },
      "today": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "sample_birth_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "required": [
      "type",
      "today"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "disclaimer": {
        "type": "string",
        "const": "For entertainment; not advice."
      },
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "source": {
        "type": "string",
        "maxLength": 500
      },
      "headline": {
        "type": "string",
        "maxLength": 200
      },
      "axes": {
        "type": "object",
        "properties": {
          "energy": {
            "type": "object",
            "properties": {
              "letter": {
                "type": "string",
                "maxLength": 1
              },
              "line": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "letter",
              "line"
            ]
          },
          "information": {
            "type": "object",
            "properties": {
              "letter": {
                "type": "string",
                "maxLength": 1
              },
              "line": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "letter",
              "line"
            ]
          },
          "decisions": {
            "type": "object",
            "properties": {
              "letter": {
                "type": "string",
                "maxLength": 1
              },
              "line": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "letter",
              "line"
            ]
          },
          "structure": {
            "type": "object",
            "properties": {
              "letter": {
                "type": "string",
                "maxLength": 1
              },
              "line": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "letter",
              "line"
            ]
          }
        },
        "required": [
          "energy",
          "information",
          "decisions",
          "structure"
        ]
      },
      "temperament_line": {
        "type": "string",
        "maxLength": 400
      },
      "notes": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 400
        },
        "maxItems": 10
      },
      "rules_version": {
        "type": "string",
        "maxLength": 40
      }
    },
    "required": [
      "answer",
      "disclaimer",
      "source",
      "axes"
    ],
    "additionalProperties": false
  },
  "rules": [
    "answer, disclaimer, source and axes are required; each axis gives the input type's letter and one line",
    "the answer starts with 'For entertainment; not advice.' and says the birth date is a sample, names the trademark holder and that the type blend is our own mapping for fun",
    "fixed rule table: the same inputs and date give the same text; no model writes it",
    "no health, money, legal or medical statements or advice and no frightening words (necklaces/fortune_rules.BANNED)",
    "no hour pillar (three pillars); dates follow the Korean lunar calendar (KASI rules) and Korea standard time"
  ],
  "test_inputs": [
    {
      "type": "INTJ",
      "sign": "Leo",
      "element": "Fire",
      "day_master": "Gap 甲",
      "today_day_pillar": "Gyeong-o 庚午",
      "today": "2026-11-18",
      "sample_birth_date": "1996-08-01"
    },
    {
      "type": "ESFP",
      "today": "2026-11-18"
    }
  ],
  "status": "draft (workflow 11-17; renamed 11-18 by PM 16:47 so no public text names a test publisher)"
}
