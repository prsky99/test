{
  "id": "github.releases.v1",
  "role": "Recent releases and newest open issues of one public GitHub repository: tags, dates, the gap between releases and issue titles (proposed by the agent team 11-15 for library-docs-check and package-risk-audit)",
  "input_schema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "maxLength": 300
      },
      "repository": {
        "type": "string",
        "maxLength": 300
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      },
      "repo": {
        "type": "string",
        "maxLength": 200
      },
      "latest_tag": {
        "type": "string",
        "maxLength": 80
      },
      "latest_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "release_gap_days": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": 4
      },
      "open_issues": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "number",
            "title"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "a release names its tag and date: \\d{4}-\\d{2}-\\d{2}",
    "a repository without releases says so instead of inventing one",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "repo": "psf/requests"
    },
    {
      "repository": "https://github.com/expressjs/express"
    }
  ]
}
