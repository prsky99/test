{
  "id": "company.registry.v1",
  "role": "Public registry identity of a company",
  "input_schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      },
      "country": {
        "type": "string",
        "maxLength": 2
      },
      "domain": {
        "type": "string",
        "maxLength": 253
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "legal_name": {
        "type": "string",
        "maxLength": 4000
      },
      "identifiers": {
        "type": "object"
      },
      "status": {
        "type": "string",
        "maxLength": 40
      },
      "address_city": {
        "type": "string",
        "maxLength": 200
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "legal_name",
      "identifiers",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "identifiers name their scheme (LEI, SEC CIK, company number)",
    "public listed or registered entities only; no person lookups"
  ],
  "test_inputs": [
    {
      "name": "Apple Inc",
      "country": "US"
    },
    {
      "name": "Microsoft Corporation",
      "country": "US"
    }
  ]
}
