{
  "id": "domain.lookup.v1",
  "role": "domain lookup (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "domain echoed: python\\.org",
    "registrar or a date: registrar|created|creation|registered|expir|\\b(?:19|20)\\d{2}-\\d{2}-\\d{2}",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "domain": "python.org"
    }
  ]
}
