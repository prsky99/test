{
  "id": "github.repo.v1",
  "role": "github repo (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "maxLength": 500
      },
      "repository": {
        "type": "string",
        "maxLength": 500
      },
      "owner": {
        "type": "string",
        "maxLength": 500
      },
      "name": {
        "type": "string",
        "maxLength": 500
      },
      "query": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "react named: facebook/react|\\breact\\b",
    "license or stars: \\bmit\\b|stars?|stargazers",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "repo": "facebook/react",
      "repository": "facebook/react",
      "owner": "facebook",
      "name": "react",
      "query": "react"
    }
  ]
}
