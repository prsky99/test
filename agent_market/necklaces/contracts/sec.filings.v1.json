{
  "id": "sec.filings.v1",
  "role": "sec filings (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "ticker": {
        "type": "string",
        "maxLength": 500
      },
      "cik": {
        "type": "string",
        "maxLength": 500
      },
      "company": {
        "type": "string",
        "maxLength": 500
      },
      "query": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "Apple or CIK 320193: apple|320193",
    "a form type: 10-k|10-q|8-k",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "ticker": "AAPL",
      "cik": "320193",
      "company": "Apple Inc",
      "query": "Apple"
    }
  ]
}
