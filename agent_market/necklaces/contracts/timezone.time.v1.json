{
  "id": "timezone.time.v1",
  "role": "timezone time (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "timezone": {
        "type": "string",
        "maxLength": 500
      },
      "tz": {
        "type": "string",
        "maxLength": 500
      },
      "city": {
        "type": "string",
        "maxLength": 500
      },
      "location": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "a clock time: \\b\\d{1,2}:\\d{2}",
    "zone named: new.?york|america/new_york|\\be[sd]t\\b|utc-0?[45]|-0[45]:00",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "timezone": "America/New_York",
      "tz": "America/New_York",
      "city": "New York",
      "location": "New York"
    }
  ]
}
