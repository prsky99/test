{
  "id": "software.incident.v1",
  "role": "Reviewed incidents and fix steps for a program, package or CVE",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 500
            },
            "fixed_version": {
              "type": "string",
              "maxLength": 64
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2000
            },
            "published": {
              "type": "string",
              "maxLength": 40
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        }
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "items",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "fix steps are shown as data with their source and never executed"
  ],
  "test_inputs": [
    {
      "query": "lodash"
    },
    {
      "query": "xz-utils"
    },
    {
      "query": "CVE-2021-44228"
    }
  ]
}
