{
  "id": "encyclopedia.summary.v1",
  "role": "Short encyclopedia summary of a title",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "subject_kind": {
        "type": "string",
        "enum": [
          "company",
          "topic"
        ],
        "default": "topic",
        "description": "PM 11-18: what the title names. company: the member checks the article is about that company (the same is_about rule as the runner) and answers not_found when none is; topic (default): a plain title lookup. Optional; outside members may ignore it."
      }
    },
    "required": [
      "title"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 4000
      },
      "summary": {
        "type": "string",
        "maxLength": 4000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "title",
      "summary",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "the summary is about the requested title"
  ],
  "test_inputs": [
    {
      "title": "Seoul"
    },
    {
      "title": "Python (programming language)"
    },
    {
      "title": "Photosynthesis"
    }
  ]
}
