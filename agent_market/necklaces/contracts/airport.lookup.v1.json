{
  "id": "airport.lookup.v1",
  "role": "airport lookup (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "maxLength": 500
      },
      "iata": {
        "type": "string",
        "maxLength": 500
      },
      "iata_code": {
        "type": "string",
        "maxLength": 500
      },
      "query": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "Incheon: incheon",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "code": "ICN",
      "iata": "ICN",
      "iata_code": "ICN",
      "query": "ICN"
    }
  ]
}
