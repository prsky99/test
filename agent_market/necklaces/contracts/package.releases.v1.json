{
  "id": "package.releases.v1",
  "role": "Release history and upkeep signals of one package from its public registry: latest version and date, maintainer count, deprecation, the gaps between recent releases and the repository (proposed by the agent team 11-15 for library-docs-check and package-risk-audit)",
  "input_schema": {
    "type": "object",
    "properties": {
      "package": {
        "type": "string",
        "minLength": 1,
        "maxLength": 214
      },
      "ecosystem": {
        "type": "string",
        "enum": [
          "npm",
          "PyPI"
        ]
      }
    },
    "required": [
      "package",
      "ecosystem"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      },
      "latest_version": {
        "type": "string",
        "maxLength": 64
      },
      "latest_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "maintainers": {
        "type": "integer",
        "minimum": 0
      },
      "deprecated": {
        "type": "boolean"
      },
      "release_gap_days": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": 4
      },
      "repository": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "repository_github": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "the latest version with its date: \\d{4}-\\d{2}-\\d{2}",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "package": "lodash",
      "ecosystem": "npm"
    },
    {
      "package": "express",
      "ecosystem": "npm"
    }
  ]
}
