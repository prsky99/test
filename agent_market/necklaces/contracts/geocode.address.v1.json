{
  "id": "geocode.address.v1",
  "role": "geocode address (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "address": {
        "type": "string",
        "maxLength": 500
      },
      "query": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "latitude 38.89: 38\\.89",
    "longitude -77.03: -77\\.0[34]",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "address": "1600 Pennsylvania Avenue NW, Washington, DC",
      "query": "1600 Pennsylvania Avenue NW, Washington, DC"
    }
  ]
}
