{
  "id": "news.search.v1",
  "role": "Recent news items for a query (same name as the existing workflow contract)",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 2,
        "maxLength": 300
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 4000
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2000
            },
            "published": {
              "type": "string",
              "maxLength": 40
            }
          },
          "required": [
            "title",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "items",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "items carry a public HTTPS link and a publication date"
  ],
  "test_inputs": [
    {
      "query": "artificial intelligence"
    },
    {
      "query": "cybersecurity"
    },
    {
      "query": "climate"
    }
  ]
}
