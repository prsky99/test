{
  "id": "holiday.calendar.v1",
  "role": "holiday calendar (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "country": {
        "type": "string",
        "maxLength": 500
      },
      "country_code": {
        "type": "string",
        "maxLength": 500
      },
      "countryCode": {
        "type": "string",
        "maxLength": 500
      },
      "year": {
        "type": "integer"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "Independence Day: independence day|2026-07-0[34]",
    "Thanksgiving: thanksgiving",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "country": "US",
      "country_code": "US",
      "countryCode": "US",
      "year": 2026
    }
  ]
}
