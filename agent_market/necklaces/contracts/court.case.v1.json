{
  "id": "court.case.v1",
  "role": "Court case and opinion lookup: case name, court, date and citation from a case-law database (PM 11-17, W3; input keys are alternatives)",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 500
      },
      "citation": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "case echoed: miranda",
    "a citation or court: \\b384\\s*U\\.?\\s*S\\.?|supreme court",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "query": "Miranda v. Arizona",
      "citation": "384 U.S. 436"
    }
  ]
}
