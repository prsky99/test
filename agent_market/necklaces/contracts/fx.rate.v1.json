{
  "id": "fx.rate.v1",
  "role": "Exchange rate between two currencies",
  "input_schema": {
    "type": "object",
    "properties": {
      "from": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "to": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "amount": {
        "type": "number"
      }
    },
    "required": [
      "from",
      "to"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "from": {
        "type": "string"
      },
      "to": {
        "type": "string"
      },
      "rate": {
        "type": "number"
      },
      "date": {
        "type": "string",
        "maxLength": 40
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "from",
      "to",
      "rate",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "the rate date is stated",
    "conversion only; no transfer or payment"
  ],
  "test_inputs": [
    {
      "from": "USD",
      "to": "EUR",
      "amount": 100
    },
    {
      "from": "USD",
      "to": "JPY",
      "amount": 100
    }
  ]
}
