{
  "id": "site.reachability.v1",
  "role": "Whether a site answers right now from a public vantage point: one GET of its home page, the status code, the final address after redirects and whether it ends on HTTPS (workflow 11-16 for website-trust-brief v2; a single check, not monitoring)",
  "input_schema": {
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "minLength": 3,
        "maxLength": 253
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      },
      "domain": {
        "type": "string",
        "maxLength": 253
      },
      "reachable": {
        "type": "boolean"
      },
      "status": {
        "type": "integer",
        "minimum": 100,
        "maximum": 599
      },
      "final_url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "https": {
        "type": "boolean"
      },
      "redirects": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "elapsed_ms": {
        "type": "integer",
        "minimum": 0
      },
      "checked_at": {
        "type": "string",
        "maxLength": 40
      }
    },
    "required": [
      "answer",
      "source",
      "reachable"
    ],
    "additionalProperties": false
  },
  "rules": [
    "domain echoed: python\\.org",
    "status named: \\b[1-5]\\d\\d\\b|unreachable|timed? ?out|refused",
    "public addresses only; one GET; the body is not kept; no account, payment or write"
  ],
  "test_inputs": [
    {
      "domain": "python.org",
      "url": "https://python.org"
    }
  ]
}
