{
  "id": "package.risk.v1",
  "role": "package risk (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "maxLength": 500
      },
      "repository": {
        "type": "string",
        "maxLength": 500
      },
      "package": {
        "type": "string",
        "maxLength": 500
      },
      "ecosystem": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "react named: react",
    "a score: score",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "repo": "github.com/facebook/react",
      "repository": "github.com/facebook/react",
      "package": "react",
      "ecosystem": "npm"
    }
  ]
}
