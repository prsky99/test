{
  "id": "unit.convert.v1",
  "role": "unit convert (default role from the pearl tests; input keys are alternatives, a member uses the ones it accepts)",
  "input_schema": {
    "type": "object",
    "properties": {
      "value": {
        "type": "integer"
      },
      "amount": {
        "type": "integer"
      },
      "from": {
        "type": "string",
        "maxLength": 500
      },
      "to": {
        "type": "string",
        "maxLength": 500
      },
      "from_unit": {
        "type": "string",
        "maxLength": 500
      },
      "to_unit": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 8000
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 2000
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "16.09: 16\\.09",
    "read-only lookup; no account, payment or write"
  ],
  "test_inputs": [
    {
      "value": 10,
      "amount": 10,
      "from": "mile",
      "to": "kilometer",
      "from_unit": "mile",
      "to_unit": "kilometer"
    }
  ]
}
