{
  "id": "events.search.v1",
  "role": "Public events for a place or month",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 200
      },
      "place": {
        "type": "string",
        "maxLength": 200
      },
      "year": {
        "type": "integer"
      },
      "month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 4000
            },
            "date": {
              "type": "string",
              "maxLength": 40
            },
            "place": {
              "type": "string",
              "maxLength": 200
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2000
            }
          },
          "required": [
            "title",
            "date"
          ],
          "additionalProperties": false
        }
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "items",
      "source"
    ],
    "additionalProperties": false
  },
  "rules": [
    "each item has a date; a member outside its coverage says so"
  ],
  "test_inputs": [
    {
      "query": "concert",
      "place": "San Francisco"
    },
    {
      "query": "festival",
      "year": 2026,
      "month": 11
    }
  ]
}
