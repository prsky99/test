{
  "slug": "company-due-diligence",
  "version": 1,
  "status": "candidate",
  "name": "Company due diligence",
  "summary": "Who a US-listed company is and what it has filed: its SEC identity (CIK and ticker), its latest SEC filings and an encyclopedia summary, plus its domain registration when you give its website. US SEC filers only in this version.",
  "input_schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      },
      "country": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "domain": {
        "type": "string",
        "pattern": "^(?=.{4,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      }
    },
    "required": [
      "name",
      "country"
    ],
    "additionalProperties": false
  },
  "budget_ms": {
    "total": 5000,
    "slot": 2500
  },
  "synthesis": {
    "kind": "merge-v1",
    "rules": [
      "identity comes from the registry step; every later step uses it (legal name, ticker)",
      "a run counts only when at least two verified pearls answered (PM 11-15: per run, not per definition)",
      "filings are the SEC filer's latest, with form and filing date",
      "every statement keeps its source link"
    ]
  },
  "answer_set": "company-due-diligence-v1",
  "slots": [
    {
      "slot": "registry",
      "contract": "company.registry.v1",
      "required": true,
      "fanout": 1,
