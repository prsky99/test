          "registrable_domain": "agentconcierge.biz",
          "upstream": [
            "sec-edgar"
          ],
          "read_only_hint": true,
          "destructive_hint": false,
          "idempotent_hint": true,
          "resend_safe": true,
          "state": "planned",
          "input_map": {
            "name": "{{input.name}}",
            "country": "{{input.country}}"
          },
          "coverage": {
            "country": [
              "US"
            ]
          }
        },
        {
          "kind": "agentcon",
          "agent_id": "gleif-lei",
