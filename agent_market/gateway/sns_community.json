     "url": "https://ap2-protocol.org/index.md", "tags": ["A2A", "AP2", "AgentCard", "결제"]},
    {"id": "a2a-x402-ext", "protocol": "a2a", "platform": "GitHub", "source": "google-agentic-commerce/a2a-x402", "stance": "neutral", "date": "2026-06-01", "date_label": "2026년",
