{
  "paper-docs-v1": {
    "name": "search_papers",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Topic words, such as \"retrieval augmented generation evaluation\""
        },
        "from_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100,
          "description": "Only papers published in this year or later"
        },
        "open_access_only": {
          "type": "boolean",
          "description": "Only papers with a free full text; false by default"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Number of papers to return, 5 by default"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "query": "systematic review intermittent fasting cardiovascular outcomes",
          "from_year": 2023
        }
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "no_results",
            "unavailable"
          ]
        },
        "query": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "venue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "openAccessUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A link to the full text that is free to read; null when the source does not confirm one, which does not mean none exists"
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "License of the open copy when the source states it"
              },
              "citedBy": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Citation count in this source; sources count differently"
              },
              "pmcid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "Europe PMC",
                  "Crossref",
                  "arXiv"
                ]
              },
              "url": {
                "type": "string",
                "description": "A page for the record"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Present when one index could not be read"
        },
        "error": {
          "type": "object",
          "description": "Present when status is not ok: a stable code, what went wrong and what to do next.",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "hint": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "hint"
          ]
        },
        "notice": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "description": "Who the data comes from, to cite and to check it against.",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "url"
          ]
        },
        "asOf": {
          "type": "string",
          "description": "Date the indexes were read (UTC, YYYY-MM-DD); they are updated continuously"
        },
        "as_of": {
          "type": "string",
          "description": "ISO 8601 time the data was published by its source or fetched from it. A cached answer keeps the time of its fetch."
        }
      },
      "required": [
        "status",
        "query",
        "count",
        "results",
        "notice",
        "source",
        "asOf",
        "as_of"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
}
