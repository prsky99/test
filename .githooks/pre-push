#!/bin/bash
# PM 11-16 source review 5.3: team sessions commit with git commit-tree (no hook runs), so the check runs on push.
# Each line on stdin: <local ref> <local sha> <remote ref> <remote sha>. See scripts/commit_check.py.
cd "$(git rev-parse --show-toplevel)" || exit 0
PY=.venv/bin/python; [ -x "$PY" ] || exit 0
rc=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$rsha" = "0000000000000000000000000000000000000000" ]; then base=$(git merge-base "$lsha" origin/claude/hopeful-darwin-i3qj6n 2>/dev/null); else base=$rsha; fi
  [ -z "$base" ] && continue
  "$PY" -m scripts.commit_check "$base..$lsha" || rc=1
done
exit $rc
