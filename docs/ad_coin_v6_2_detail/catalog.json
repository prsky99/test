  "core_entities": [
    {
      "name": "adc2_principals",
      "key": "principals",
      "scope": "R0",
      "required_definition": "id PK, kind text CHECK enum, credential_epoch bigint, status, subject_owner_id UUID 선택, expires_at. UNIQUE(environment, issuer, external_subject). 직접적인 업무 호출 kind와 실제 owner를 분리한다."
    },
    {
      "name": "adc2_authority_guards",
      "key": "authority_guards",
      "scope": "R0",
      "required_definition": "guard_type, guard_id 복합 PK, epoch, status. principal·grant·organization·owner별 철회 선형화 지점이다. 단순 수익 수취자까지 모두 authority guard로 잠그지 않아 전역 platform 병목을 만들지 않는다."
    },
    {
      "name": "adc2_memberships",
      "key": "memberships",
      "scope": "R0",
      "required_definition": "commercial_tenant_id, principal_id, capability, grant_epoch, revoked_at. UNIQUE(tenant, principal, capability). 활성 membership만 인가에 사용한다."
    },
    {
      "name": "adc2_agent_bindings",
      "key": "agent_bindings",
      "scope": "R0",
      "required_definition": "id, owner_id, agent_principal_id, operator_id, credential_epoch, audience, capabilities, revoked_at. UNIQUE(id, owner_id). key secret은 해시/별도 credential store이며 업무 row에 plaintext로 두지 않는다."
    },
    {
      "name": "adc2_ad_preferences",
      "key": "ad_preferences",
      "scope": "R0",
      "required_definition": "id, owner_id, purpose, receive_offers, context_fields, max_offers/day, max_ads/day, max_ads/campaign/day, max_ad_ms/day, version, revision_hash. UNIQUE(owner_id, purpose). 기본은 수신 비활성·공유 없음이다."
    },
    {
      "name": "adc2_fresh_actions",
      "key": "fresh_actions",
      "scope": "R0",
      "required_definition": "id, principal_id, session_binding_hash, action, target_id, target_revision_hash, semantic_digest, challenge_hash UNIQUE, expires_at, consumed_by_operation 선택. challenge 소비는 수신 command의 커밋과 원자적이다."
    },
    {
      "name": "adc2_advertisers",
      "key": "advertisers",
      "scope": "R0",
      "required_definition": "id, commercial_tenant_id UNIQUE, verification_status, brand_rights_ref, jurisdiction_profile, status. KYC 원문은 별도 보호 저장소 참조다."
    },
    {
      "name": "adc2_campaigns",
      "key": "campaigns",
      "scope": "R0",
      "required_definition": "id, advertiser_id, current_revision_id, state, approval_status, version. UNIQUE(id, advertiser_id). workflow 상태 변경마다 version 증가."
    },
    {
      "name": "adc2_campaign_revisions",
      "key": "campaign_revisions",
      "scope": "R0",
      "required_definition": "id, campaign_id, advertiser_id, revision_no, content_hash, asset_id, total_budget_atoms, daily_budget_atoms, timezone, starts_at, ends_at, product=P1, gross_p1_atoms, split_bps, exact_split_atoms, min_exposure_ms, creative_hash/text_ref, renderer_profile. UNIQUE(campaign_id, revision_no), UNIQUE(id, advertiser_id), CHECK daily<=total·ends>starts·사용자 보상>0."
    },
    {
      "name": "adc2_reviews",
      "key": "reviews",
      "scope": "R0",
      "required_definition": "id, advertiser_id, campaign_id, campaign_revision_id, state, version, reviewer_principal 선택, evidence_ref 선택, reason. 같은 campaign/revision의 활성 pending 심사 하나에 partial unique index."
    },
    {
      "name": "adc2_approvals",
      "key": "approvals",
      "scope": "R0",
      "required_definition": "id, campaign_revision_id, content_hash, approver_principal, fresh_action_id UNIQUE, approved_at, expires_at, grant_epoch. UNIQUE(revision, approver, approval_purpose). 승인한 revision과 실제 활성 revision이 같아야 한다."
    },
    {
      "name": "adc2_assets",
      "key": "assets",
      "scope": "R0",
      "required_definition": "id text PK, namespace, chain_id 선택, token_contract 선택, decimals=6, activation_manifest_ref 선택. model은 체인 identity가 null이며 정식 자산과 ID를 공유하지 않는다."
    },
    {
      "name": "adc2_accounts",
      "key": "accounts",
      "scope": "R0",
      "required_definition": "id, owner_id, manager_binding_id 선택, asset_id, purpose, beneficial, account_class, balance_atoms. UNIQUE(id, asset_id). manager null/non-null 두 partial unique index로 owner/asset/purpose/manager의 중복을 막는다. campaign/hold 등 목적 계정에는 object_ref를 포함한다."
    },
    {
      "name": "adc2_journals",
      "key": "journals",
      "scope": "R0",
      "required_definition": "id, asset_id, economic_event_key, operation_id, kind, committed_at. UNIQUE(environment, asset_id, economic_event_key), UNIQUE(id, asset_id). 확정 후 UPDATE/DELETE 금지."
    },
    {
      "name": "adc2_postings",
      "key": "postings",
      "scope": "R0",
      "required_definition": "journal_id, line_no, asset_id, account_id, signed_delta. PK(journal_id, line_no), 복합 FK(journal_id,asset_id)·(account_id,asset_id). 같은 journal의 delta 합 0을 command와 commit-time DB 검증으로 강제한다."
    },
    {
      "name": "adc2_budget_windows",
      "key": "budget_windows",
      "scope": "R0",
      "required_definition": "id, campaign_id, asset_id, window_kind(total/day), window_start/end, limit_atoms, reserved_atoms, spent_atoms, version. UNIQUE(campaign, kind, start), CHECK reserved>=0·spent>=0·reserved+spent<=limit."
    },
    {
      "name": "adc2_budget_holds",
      "key": "budget_holds",
      "scope": "R0",
      "required_definition": "id, offer_id UNIQUE, asset_id, total_window_id, day_window_id, hold_account_id, initial_atoms, remaining_atoms, state, qualification_deadline, review_deadline. remaining은 실제 hold 계정 잔액과 대사한다. 같은 금액을 B에 두 번 합산하지 않는다."
    },
    {
      "name": "adc2_stage_awards",
      "key": "stage_awards",
      "scope": "R0",
      "required_definition": "id, offer_id, stage_key, occurrence, evidence_verdict_id, journal_id UNIQUE, receipt_id UNIQUE. UNIQUE(offer,stage,occurrence), 단계별 동일 원본 evidence 재사용 제한."
    },
    {
      "name": "adc2_offers",
      "key": "offers",
      "scope": "R0",
      "required_definition": "id, campaign_revision_id, advertiser_id, owner_id, agent_binding_id 선택, wallet_id, fallback_wallet_id, quote_hash, quote_snapshot, hold_id, state, version, expires_at. UNIQUE(id,owner_id). quote에는 asset·정확한 split·기한·관리 철회 fallback·검토 조건을 포함한다."
    },
    {
      "name": "adc2_human_consents",
      "key": "human_consents",
      "scope": "R0",
      "required_definition": "id, offer_id, owner_id, quote_hash, fresh_action_id UNIQUE, version, created_at, revoked_at. 복합 FK(offer,owner), UNIQUE(offer,owner,quote_hash). 소비와 취소 이력은 보존한다."
    },
    {
      "name": "adc2_exposure_sessions",
      "key": "exposure_sessions",
      "scope": "R0",
      "required_definition": "id, offer_id, owner_id, consent_id/version, state, nonce_sequence, next_nonce_hash, startup_deadline, first_signal_at 선택, active_deadline 선택, evidence_deadline, cutoff_at 선택, collected_valid_ms, max_view_ms, version. 같은 offer의 활성 세션 하나에 partial unique index."
    },
    {
      "name": "adc2_evidence_chunks",
      "key": "evidence_chunks",
      "scope": "R0",
